# SNAPENG - configuração local

# Aplicação
APP_NAME=SNAPENG
APP_VERSION=1.0.0
DEBUG=true

# Banco de dados
# SQLite canonico: sempre {raiz-do-repo}/snapeng.db (independente do cwd).
DATABASE_URL=sqlite:///./snapeng.db
# PostgreSQL: postgresql://snapeng_user:snapeng_pass@localhost:5432/snapeng
POSTGRES_USER=snapeng_user
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=snapeng

# Segurança
# Em produção (DEBUG=false), use chave aleatória com 32+ caracteres.
# Valores contendo "dev-secret", "change-this" ou "changeme" são rejeitados fora de DEBUG.
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Hosts permitidos quando DEBUG=false (TrustedHost)
ALLOWED_HOSTS=localhost,127.0.0.1
# Só true atrás de proxy reverso confiável (nginx/Caddy). Nunca em exposição direta.
TRUST_PROXY_HEADERS=false

# IA - opcional durante o desenvolvimento
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Redis - opcional durante o desenvolvimento
REDIS_URL=redis://localhost:6379/0

# Armazenamento e integrações - reservados para etapas futuras
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=snapeng-documents
AWS_REGION=us-east-1
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RESEND_API_KEY=
FROM_EMAIL=noreply@snapeng.com.br
